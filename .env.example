# Ollama embedding endpoint (used by the indexer and the search_codebase tool)
EMBED_URL=http://127.0.0.1:11434/api/embed

# Ollama base URL (used by ChatOllama for the agent and helper models)
OLLAMA_URL=http://127.0.0.1:11434/

# Root directory for per-session artifacts (generated files, CONTEXT*.md, history.json)
SESSION_PATH=/tmp/RagLLM

# Optional alternative Ollama endpoint (for the ornith title-generation model)
ORNITH_URL=http://127.0.0.1:11434/
